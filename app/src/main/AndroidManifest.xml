<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Spike 1 + 2: Microphone ──────────────────────────── -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ── Foreground service base permission ───────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required when foregroundServiceType includes "microphone" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Required when foregroundServiceType includes "specialUse" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Notifications (Android 13+) ──────────────────────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Spike 3: Background launch routes ────────────────── -->
    <!-- Overlay window (SYSTEM_ALERT_WINDOW) – requested at runtime -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Full-screen intent (Android 14+ requires declaration) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ── Spike 4: Screen wake ──────────────────────────────── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Spike 5: Calling ──────────────────────────────────── -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- ── Phase 2: Contact Search ────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- ── Auto-start & App Launching ────────────────────────── -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />


    <application
        android:name=".SpikeApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpideySpikes">

        <!-- ── Main launcher activity ───────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Spike 4: Unlock helper – transparent, shows over lock screen -->
        <activity
            android:name=".spike4.UnlockHelperActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ── Foreground service for all spikes ─────────────── -->
        <!--
            foregroundServiceType="microphone" for Spikes 1 & 2.
            foregroundServiceType="specialUse" for Spikes 3, 4, 6.
            Combined here so a single service covers all cases.
        -->
        <service
            android:name=".service.SpikeForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="SPIDEY Phase-0 feasibility spikes – background launch, unlock, and screen-off tests" />
        </service>

        <!-- ── Phase 1: Assistant Unlock Activity ───────────────────── -->
        <activity
            android:name="com.spidey.assistant.unlock.UnlockActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ── Phase 1: Assistant WakeWordService ─────────────────────── -->
        <service
            android:name="com.spidey.assistant.voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- ── Boot Receiver for auto-start on device power-on ────────── -->
        <receiver
            android:name="com.spidey.assistant.voice.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

    <!-- ── App install packages that may be queried ──────── -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.whatsapp" />
        <package android:name="com.android.chrome" />
        <package android:name="com.spotify.music" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.gm" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

</manifest>
